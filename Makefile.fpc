# dcs - a command line Gemini client
#
#   make -f Makefile.fpc              build with TaurusTLS (TLS 1.3)
#   make -f Makefile.fpc USE_TAURUS=0 build with Indy's OpenSSL (TLS 1.2 max)
#   make -f Makefile.fpc check
#   make -f Makefile.fpc test        end to end tests, needs agena built
#   make -f Makefile.fpc clean
#
# Indy is a submodule here too, so the client and the server it talks to can be
# built from the same source.

FPC        ?= fpc
USE_TAURUS ?= 1

INDY   := third_party/Indy/Lib
TAURUS := third_party/TaurusTLS/Source

BUILDDIR := build
TARGET   := $(BUILDDIR)/dcs
UNITS    := $(BUILDDIR)/units

DCS_UNITS := $(wildcard src/Units/*.pas)

PATHS := -Fu$(INDY)/Core -Fu$(INDY)/System -Fu$(INDY)/Protocols \
         -Fu$(INDY)/Security
INCS  := -Fi$(INDY)/Core -Fi$(INDY)/Protocols -Fi$(INDY)/Security

ifeq ($(USE_TAURUS),1)
FPCOPT := -dUSE_TAURUS
PATHS += -Fu$(TAURUS)
endif

# The suite drives the built dcs against an agena built from the same Indy, so
# both have to exist. Override AGENA_DIR if agena lives somewhere else.
AGENA_DIR ?= ../agena

.PHONY: all clean check test

all: $(TARGET)

$(TARGET): src/dcs.lpr $(DCS_UNITS)
	mkdir -p $(BUILDDIR) $(UNITS)
	$(FPC) -Mdelphi -O2 -g -gl $(FPCOPT) \
	  -FU$(UNITS) -FE$(BUILDDIR) -Fusrc/Units \
	  $(PATHS) $(INCS) $<

check:
	@command -v $(FPC) >/dev/null || { echo "fpc not found in PATH"; exit 1; }
	@test -d third_party/Indy || { echo "missing submodule: Indy"; exit 1; }
	@if [ "$(USE_TAURUS)" = "1" ]; then \
	   test -d third_party/TaurusTLS || { echo "missing submodule: TaurusTLS"; exit 1; }; \
	 fi
	@echo "all dependencies present"

test: $(TARGET)
	@test -x $(AGENA_DIR)/build/agena || { \
	   echo "agena not found at $(AGENA_DIR)/build/agena"; \
	   echo "build it with: make -C $(AGENA_DIR) -f Makefile.fpc"; exit 1; }
	@DCS_BIN=$(CURDIR)/$(TARGET) AGENA_DIR=$(AGENA_DIR) python3 tests/run_tests.py

clean:
	rm -rf $(BUILDDIR)
